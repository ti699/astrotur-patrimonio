FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_URL=/api
ARG VITE_HUB_URL=
ARG VITE_HUB_SSO_URL=
ARG VITE_HUB_LOGIN_PATH=/login
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_HUB_URL=$VITE_HUB_URL
ENV VITE_HUB_SSO_URL=$VITE_HUB_SSO_URL
ENV VITE_HUB_LOGIN_PATH=$VITE_HUB_LOGIN_PATH
RUN npx vite build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=5173 HOST=0.0.0.0
COPY --from=build /app/dist ./dist
EXPOSE 5173
CMD ["node", "dist/server/index.mjs"]
