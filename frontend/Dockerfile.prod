FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npx vite build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=5173 HOST=0.0.0.0
COPY --from=build /app/dist ./dist
EXPOSE 5173
CMD ["node", "dist/server/index.mjs"]
